{
  "name": "watchtowerobservability/sdk",
  "description": "Thin Watchtower distribution over the OpenTelemetry PHP SDK",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.1",
    "open-telemetry/sdk": "^1.1",
    "open-telemetry/exporter-otlp": "^1.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "open-telemetry/opentelemetry-logger-monolog": "^1.0",
    "monolog/monolog": "^3.0",
    "guzzlehttp/guzzle": "^7.8"
  },
  "autoload": {
    "psr-4": {
      "Watchtower\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Watchtower\\Tests\\": "tests/"
    }
  },
  "suggest": {
    "open-telemetry/opentelemetry-logger-monolog": "Monolog records as OTLP logs (Watchtower::monolog)"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": false
    }
  }
}
