{
  "name": "watchtowerobservability/sdk",
  "description": "Thin Watchtower distribution over the OpenTelemetry PHP SDK",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.1",
    "open-telemetry/sdk": "^1.1",
    "open-telemetry/exporter-otlp": "^1.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4"
  },
  "autoload": { "psr-4": { "Watchtower\\": "src/" } },
